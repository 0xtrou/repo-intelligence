{
  "name": "repo-intelligence",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xtrou/repo-intelligence.git"
  },
  "description": "Architect & benchmark intelligence for any repo/harness — prescribe tooling, define metrics, measure, derive insight.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "profile": "ts-node src/profile.ts",
    "plan": "ts-node src/plan.ts",
    "measure": "ts-node src/measure.ts",
    "insight": "ts-node src/insight.ts",
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS='-r ts-node/register' TS_NODE_TRANSPILE_ONLY=1 node --test",
    "prepare": "husky"
  },
  "dependencies": {
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@types/node": "25.9.8",
    "husky": "9.1.7"
  }
}
